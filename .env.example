# =====================================================================
# TARKYAAN (तर्कयान) — Environment Configuration Template
# =====================================================================
# INSTRUCTIONS:
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file or real credentials to git.
# =====================================================================

# --- AI Provider API Keys ---
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=

# --- External Search & Web Services ---
TAVILY_API_KEY=
ELEVENLABS_API_KEY=
OPENWEATHER_API_KEY=
NEWSAPI_KEY=
GOOGLE_MAPS_API_KEY=

# --- Google OAuth Credentials (Optional / Planned) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=


# --- Tarkyaan Application Settings ---
TARKYAAN_APP_NAME=Tarkyaan
TARKYAAN_APP_ENV=development
TARKYAAN_DEBUG=false
TARKYAAN_LOG_LEVEL=INFO
TARKYAAN_DATABASE_PATH=data/tarkyaan.db

# --- Voice & Audio Settings (Phase 5) ---
TARKYAAN_VOICE_LANGUAGE=en
TARKYAAN_TTS_VOICE=hi-IN-SwaraNeural
TARKYAAN_STT_MODEL=whisper-1

