# =====================================================================
# TARKYAAN (तर्कयान) — Environment Configuration Template
# =====================================================================
# INSTRUCTIONS:
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file or real credentials to git.
# =====================================================================

# --- AI Provider API Keys ---
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=

# --- External Search & Web Services ---
TAVILY_API_KEY=
ELEVENLABS_API_KEY=
OPENWEATHER_API_KEY=
NEWSAPI_KEY=
GOOGLE_MAPS_API_KEY=

# --- Tarkyaan Application Settings ---
TARKYAAN_APP_NAME=Tarkyaan
TARKYAAN_APP_ENV=development
TARKYAAN_DEBUG=false
TARKYAAN_LOG_LEVEL=INFO
TARKYAAN_DATABASE_PATH=data/tarkyaan.db

# --- Tarkyaan Engine Parameters ---
TARKYAAN_DEFAULT_MASTERY_LEARNING_RATE=0.25
TARKYAAN_UNCERTAINTY_DECAY_RATE=0.75
TARKYAAN_DEFAULT_RETENTION_HALF_LIFE_DAYS=14.0
TARKYAAN_DEFAULT_RETENTION_BASELINE=0.1
TARKYAAN_DEFAULT_RETRIEVAL_TOKEN_BUDGET=1500

