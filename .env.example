# =====================================================================
# TARKYAAN / NOVA — Environment Configuration Template
# =====================================================================
# INSTRUCTIONS:
# Copy this file to .env and fill in your actual API keys.
# NEVER commit the actual .env file or real credentials to git.
# =====================================================================

# --- AI Provider API Keys ---
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here

# --- External Web Services ---
TAVILY_API_KEY=your_tavily_search_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here
NEWS_API_KEY=your_news_api_key_here
GOOGLE_MAPS_API_KEY=

# --- Application Runtime ---
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# --- Voice & Speech Configuration ---
VOICE_ENABLED=true
VOICE_NAME=Tarkyaan
TTS_ENGINE=edge_tts
TTS_VOICE=hi-IN-SwaraNeural
STT_ENGINE=whisper
WHISPER_MODEL_NAME=small
STT_LANGUAGE=auto

# --- Browser & Automation Defaults ---
DEFAULT_BROWSER=chrome
DESKTOP_WORKSPACE_DIR=~/Desktop/NOVA_WORKSPACE
DESKTOP_CAMERA_OUTPUT_DIR=~/Pictures/NOVA

# --- Telemetry & Debug Flags ---
NOVA_BROWSER_DEBUG=false
NOVA_INTENT_DEBUG=false
NOVA_MEDIA_DEBUG=false
NOVA_ENVIRONMENT_DEBUG=false
NOVA_COMPUTER_AGENT_DEBUG=false
NOVA_TASK_AGENT_DEBUG=false
