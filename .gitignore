# =====================================================================
# TARKYAAN — Git Ignore Rules & Secret Protection
# =====================================================================

# Environment Variables & Secrets (CRITICAL: Zero Secrets in Git)
.env
.env.*
.env.local
.env.development
.env.test
.env.production
!.env.example
credentials.json
client_secret*.json
*.pem
*.key
*.cert
*.p12

# Python & Caches
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual Environments
.venv/
venv/
ENV/
env/

# IDE & OS Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.vscode/
.idea/
*.swp
*.swo

# Application Logs & Runtime Database State
logs/
*.log
data/*.db
data/*.sqlite
data/memory/memory_store.json.corrupt.*
data/memory/corrupt/

# Media, Screen Recordings, Audio Buffers
recordings/
screenshots/
*.mp4
*.mov
*.mkv
*.webm
*.wav
*.mp3

# Frontend & Node Dependencies
node_modules/
**/node_modules/
dist/
build/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
